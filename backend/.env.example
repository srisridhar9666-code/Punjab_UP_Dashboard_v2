# Copy to backend/.env and fill in. Never commit the real .env.

# Required. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production   (production: secure cookies, no /docs page)
ENVIRONMENT=development

# Database: either a full URL ...
# DATABASE_URL=mysql+pymysql://admin:password@localhost:3306/callcenter_dashboard?charset=utf8mb4
# ... or the same DB_* values v1 used:
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=callcenter_dashboard

# Browser origins allowed to call the API (JSON list). Not needed when the API serves the built frontend itself.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Session length in minutes (default 8 hours)
ACCESS_TOKEN_MINUTES=480

# Upload limits and rollback history
MAX_UPLOAD_MB=25
UPLOAD_KEEP=10

# Optional: create the first admin automatically on an EMPTY database (must change password at first sign-in)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
